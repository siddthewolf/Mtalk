# Copy this file to .env and fill in your CoinDCX API credentials.
# The agent works WITHOUT credentials (market scan only).
# Add credentials to enable portfolio sync + order tracking.

# Get your keys from: https://coindcx.com/settings/api
COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here
